QSINT_ENABLE_ETL=false
QSINT_WORKER_MODULES=["examples.workers"]
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
WORKER_NAME=qf-example
QSINT_ERROR_TOPIC=qf.errors
QSINT_REDIS_URL=redis://localhost:26379/0
QSINT_IDEMPOTENCY_ENABLED=false
QSINT_IDEMPOTENCY_TTL_SEC=86400
QSINT_PENDING_MAX_PER_TP=750
QSINT_POLL_TIMEOUT_MS=25
QSINT_COMMIT_TICK_SEC=0.2
QSINT_RETRY_ATTEMPTS=3
QSINT_RETRY_BASE_SEC=0.25
QSINT_RETRY_MAX_SEC=10
QSINT_LOG_LEVEL=INFO
QSINT_ENABLE_TRACING=false
# QSINT_OTLP_ENDPOINT=http://localhost:4317
# QSINT_OTLP_INSECURE=true
